; Vallidyn University — Godot 4.7 project.
; Phase 1 is a headless, deterministic, fully-typed rules engine (see spec §1).
; Engine type=4 + config_version=5 = Godot 4.x.

config_version=5

[application]

config/name="Vallidyn University"
config/description="Single-player PF2e/SF2e Remastered CRPG. Phase 1: headless rules engine."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[rendering]

renderer/rendering_method="forward_plus"

[debug]

; The rules core must be statically typed end-to-end (spec §2). Flag genuinely
; untyped declarations (var x = ...) in our own code; `:=` is inferred-but-static
; and stays clean. Never flag the third-party GUT addon.
gdscript/warnings/exclude_addons=true
gdscript/warnings/untyped_declaration=1
